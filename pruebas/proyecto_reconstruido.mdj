											},
											"headRoleNameLabel": {
												"$ref": "AAAAAAGg6b7Xibh317A="
											},
											"headPropertyLabel": {
												"$ref": "AAAAAAGg6b7XjPHnWlo="
											},
											"headMultiplicityLabel": {
												"$ref": "AAAAAAGg6b7Xj7WD5J4="
											},
											"tailQualifiersCompartment": {
												"$ref": "AAAAAAGg6b7XkvTue2g="
											},
											"headQualifiersCompartment": {
												"$ref": "AAAAAAGg6b7Xlt/utCM="
											}
										},
										{
											"_type": "UMLNoteView",
											"_id": "AAAAAAGg6b7XqTv/gbQ=",
											"_parent": {
												"$ref": "AAAAAAGUYVWeMWJyTA8="
											},
											"font": "Arial;11;0",
											"parentStyle": false,
											"left": 548,
											"top": 436,
											"width": 284,
											"height": 71,
											"text": "Junta MenuPrincipal, SeleccionCliente, RegistroNuevoCliente, BCSolicitudRenta y MensajeError. Todas sirven para lo mismo: buscar al cliente (o darlo de alta) y capturar la obra, el periodo y las condiciones de la solicitud."
										},
										{
											"_type": "UMLNoteView",
											"_id": "AAAAAAGg6b7XqqpkX4g=",
											"_parent": {
												"$ref": "AAAAAAGUYVWeMWJyTA8="
											},
											"font": "Arial;11;0",
											"parentStyle": false,
											"left": 572,
											"top": 651,
											"width": 262,
											"height": 81,
											"text": "Junta AnalisisRequerimiento, EquiposCompatibles, SeleccionEquipo y SeleccionAccesorios. En una sola pantalla el asesor registra los requerimientos, compara los equipos, elige el recomendado y la alternativa y propone los accesorios."
										},
										{
											"_type": "UMLNoteView",
											"_id": "AAAAAAGg6b7XrVOoTw4=",
											"_parent": {
												"$ref": "AAAAAAGUYVWeMWJyTA8="
											},
											"font": "Arial;11;0",
											"parentStyle": false,
											"left": 545,
											"top": 1037,
											"width": 276,
											"height": 73,
											"text": "Junta ConfirmacionPeriodo, VerificacionInventario, VerificacionDisponibilidad, CalendarioUnidad y DetalleEstadoUnidad. El periodo ya viene de F1; aquí solo se consultan las unidades y su ocupación y se escoge una libre, sin apartarla."
										},
										{
											"_type": "UMLNoteView",
											"_id": "AAAAAAGg6b7XstK82zg=",
											"_parent": {
												"$ref": "AAAAAAGUYVWeMWJyTA8="
											},
											"font": "Arial;11;0",
											"parentStyle": false,
											"left": 548,
											"top": 1252,
											"width": 240,
											"height": 71,
											"text": "Junta PropuestaRenta, RegistroRequisitos, VerificacionRequisitos, CotizacionRenta y PreparacionCotizacion. Muestra en un solo lugar la cotización por partidas, el IVA, el total, el depósito y los requisitos."
										},
										{
											"_type": "UMLNoteView",
											"_id": "AAAAAAGg6b7Xt0e/HUA=",
											"_parent": {
												"$ref": "AAAAAAGUYVWeMWJyTA8="
											},
											"font": "Arial;11;0",
											"parentStyle": false,
											"left": 552,
											"top": 1477,
											"width": 268,
											"height": 61,
											"text": "Es la misma pantalla ConfirmacionContratacion. Muestra las condiciones completas, registra la decisión del cliente, confirma la contratación y avisa que se generó la orden."
										},
										{
											"_type": "UMLNoteView",
											"_id": "AAAAAAGg6b7XunH6acE=",
											"_parent": {
												"$ref": "AAAAAAGUYVWeMWJyTA8="
											},
											"font": "Arial;11;0",
											"parentStyle": false,
											"left": 872,
											"top": 1316,
											"width": 166,
											"height": 60,
											"text": "Conecta al sistema con el servicio de correo. Así el control no le manda nada directo al actor externo."
										}
									]
								},
